{
	"name": "nunjucks-pathrunner",
	"displayName": "Nunjucks Pathrunner",
	"description": "Ctrl + click and Go to Definition support for static Nunjucks template paths.",
	"version": "1.0.3",
	"icon": "images/icon.png",
	"publisher": "saibal",
	"license": "MIT",
	"engines": {
		"vscode": "^1.70.0"
	},
	"categories": [
		"Programming Languages",
		"Other"
	],
	"keywords": [
		"nunjucks",
		"njk",
		"template",
		"go to definition",
		"ctrl click",
		"path",
		"include",
		"extends",
		"import"
	],
	"bugs": {
		"url": "https://github.com/saiballo/vscode-nunjucks-pathrunner/issues",
		"email": "lorenzo.forti@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/saiballo/vscode-nunjucks-pathrunner.git"
	},
	"homepage": "https://github.com/saiballo/vscode-nunjucks-pathrunner/",
	"main": "./extension.js",
	"activationEvents": [
		"onLanguage:nunjucks",
		"workspaceContains:**/*.njk"
	],
	"contributes": {
		"configuration": {
			"title": "Nunjucks Pathrunner Path",
			"description": "Base path used to resolve Nunjucks template links.",
			"properties": {
				"nunjucksTemplatePath.includePath": {
					"type": "string",
					"default": "src/view/_include",
					"description": "Base path used to resolve Eleventy/Nunjucks template links."
				}
			}
		}
	},
	"scripts": {
		"package": "npx @vscode/vsce package"
	},
	"files": [
		"extension.js",
		"images",
		"README.md",
		"LICENSE.txt"
	]
}